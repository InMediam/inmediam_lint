{
  "name": "@inmediam/lint",
  "version": "1.1.0",
  "description": "Configuração de ESLint (flat config, ESLint 9+) padrão da Inmediam.",
  "license": "MIT",
  "type": "module",
  "main": "base.mjs",
  "exports": {
    ".": "./base.mjs",
    "./base": "./base.mjs",
    "./node": "./node.mjs",
    "./react": "./react.mjs",
    "./tailwind": "./tailwind.mjs",
    "./prettier": "./prettier.mjs"
  },
  "files": [
    "base.mjs",
    "node.mjs",
    "react.mjs",
    "tailwind.mjs",
    "prettier.mjs",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InMediam/inmediam_lint.git"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "inmediam"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.60.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "eslint": "^9.39.4",
    "typescript": "^5.9.0"
  }
}
